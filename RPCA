# 鲁棒PCA去噪
def robust_pca_denoise(data, n_components=1):
    pca = PCA(n_components=n_components)
    denoised = pca.inverse_transform(pca.fit_transform(data.reshape(-1, 1)))
    return denoised.flatten()

# 应用鲁棒PCA去噪
denoised_observed = robust_pca_denoise(y_observed)

# 支路1的车流量模型
def f1(t, params):
    a, b, c, d, k1, k2 = params
    if t < a:
        return 0
    elif a <= t < b:
        return k1 * (t - a)
    elif b <= t < c:
        return k1 * (b - a)
    elif c <= t < d:
        return k1 * (b - a) - k2 * (t - c)
    else:
        return 0

# 支路2的车流量模型
def f2(t, params):
    p1, q1, r, p2 = params
    if t < 0:  
        return q1  
    elif t < 17:  
        return p1 * t + q1
    elif 17 <= t < 35:  
        return r
    else: 
        return r + p2 * (t - 35)

# 支路3的车流量模型
def f3(t, light_cycles):
    for cycle in light_cycles:
        start, end, model_type, params = cycle
        if start <= t < end:
            if model_type == 'constant':
                return params[0]
            elif model_type == 'linear':
                slope, intercept = params
                return slope * (t - start) + intercept
    return 0  

# 计算总车流量 - 考虑时间延迟
def total_flow(t, f1_params, f2_params, light_cycles, delay=1):
   
    t1 = t - delay
    
    flow1 = f1(t1, f1_params) if t1 >= -1 else 0  # 支持t=-1
    flow2 = f2(t1, f2_params) if t1 >= -1 else 0  # 支持t=-1
    flow3 = f3(t, light_cycles)
    
    return flow1 + flow2 + flow3

# 计算总车流量 - 不考虑时间延迟
def total_flow_no_delay(t, f1_params, f2_params, light_cycles):

    flow1 = f1(t, f1_params) if t >= 0 else 0
    flow2 = f2(t, f2_params) if t >= 0 else 0
    flow3 = f3(t, light_cycles)
    
    return flow1 + flow2 + flow3

# 残差函数
def residuals(params, t, observed, f1_params, f2_params, light_cycles):
    model_flow = np.array([total_flow(i, f1_params, f2_params, light_cycles) for i in t])
    return np.sum((observed - model_flow) ** 2)

# 计算MAPE
def safe_mape(y_true, y_pred):
    mask = y_true != 0
    if np.sum(mask) == 0:
        return np.nan
    return np.mean(np.abs((y_true[mask] - y_pred[mask]) / y_true[mask])) * 100

# 计算PSI（Population Stability Index）
def calculate_psi(expected, actual, bins=10):
    min_val = min(min(expected), min(actual))
    max_val = max(max(expected), max(actual))
    breaks = np.linspace(min_val, max_val, bins+1)
    
    expected_perc = np.histogram(expected, breaks, density=True)[0]
    actual_perc = np.histogram(actual, breaks, density=True)[0]

    expected_perc = np.clip(expected_perc, 1e-5, 1)
    actual_perc = np.clip(actual_perc, 1e-5, 1)
    
    # 计算PSI
    psi = np.sum((actual_perc - expected_perc) * np.log(actual_perc / expected_perc))
    return psi

# 计算SSS（Structural Similarity Score）
def calculate_sss(observed, predicted):
    mu_obs = np.mean(observed)
    mu_pred = np.mean(predicted)
    covar = np.cov(observed, predicted)[0, 1]
    var_obs = np.var(observed)
    var_pred = np.var(predicted)
    
    # 稳定性常数
    c1 = (0.01 * np.max(observed)) ** 2
    c2 = (0.03 * np.max(observed)) ** 2
    
    # 计算SSS
    sss = ((2 * mu_obs * mu_pred + c1) * (2 * covar + c2)) / \
           ((mu_obs ** 2 + mu_pred ** 2 + c1) * (var_obs + var_pred + c2))
    return sss

# EM算法优化
def em_algorithm(observed, t, light_cycle_length=9, green_duration=5, red_duration=4):
    # 初始化参数 
    f1_params = [5, 20, 40, 50, 0.85, 0.64]  # a, b, c, d, k1, k2
    f2_params = [0.52, 20.12, 18.64, -0.42]  # p1, q1, r, p2 修正：q1=20.12
    
    # 确定信号灯周期
    best_error = float('inf')
    best_light_cycles = None
    
    # 尝试不同的绿灯起始时间
    for start_time in range(0, 9):  
        light_cycles = []
        current_time = start_time
        while current_time < 60:
            # 绿灯时段
            green_start = current_time
            green_end = min(current_time + green_duration, 60)
            light_cycles.append((green_start, green_end, 'constant', [5.0]))
            
            # 红灯时段
            current_time += light_cycle_length
    
        # 计算误差
        error = residuals(f1_params + f2_params, t, observed, f1_params, f2_params, light_cycles)
        if error < best_error:
            best_error = error
            best_light_cycles = light_cycles
    
    light_cycles = best_light_cycles
    
    # 优化参数
    def objective(params):
        f1_p = params[:6]
        f2_p = params[6:10]
        return residuals(params, t, observed, f1_p, f2_p, light_cycles)
    
    initial_params = f1_params + f2_params
    bounds = [
        (0, 10), (15, 25), (35, 45), (45, 55), (0.5, 1.5), (0.3, 0.8),
        (0.3, 0.7), (18, 22), (15, 20), (-0.5, -0.3)  
    ]
    
    result = minimize(objective, initial_params, bounds=bounds, method='L-BFGS-B')
    optimized_params = result.x
    
    # 分离参数
    f1_params_opt = optimized_params[:6]
    f2_params_opt = optimized_params[6:10]
    
    # 优化支路3模型
    optimized_light_cycles = []
    for cycle in light_cycles:
        start, end, _, _ = cycle
        indices = np.where((t >= start) & (t < end))[0]
        if len(indices) == 0:
            continue
        
        # 提取残差
        res = observed[indices] - np.array([
            f1(t_val - 1, f1_params_opt) + f2(t_val - 1, f2_params_opt) 
            for t_val in t[indices]
        ])
        
        # 尝试常数模型
        constant_val = np.mean(res)
        error_constant = np.sum((res - constant_val) ** 2)
        
        # 尝试线性模型
        A = np.vstack([t[indices] - start, np.ones(len(indices))]).T
        linear_params, _, _, _ = np.linalg.lstsq(A, res, rcond=None)
        error_linear = np.sum((res - A.dot(linear_params)) ** 2)
        
        # 选择更好的模型
        if error_constant < error_linear:
            optimized_light_cycles.append((start, end, 'constant', [constant_val]))
        else:
            optimized_light_cycles.append((start, end, 'linear', linear_params))
    
    return f1_params_opt, f2_params_opt, optimized_light_cycles

