# 定义最终函数 
def f1(t_val):
    if t_val < t1:
        return 0.0
    elif t1 <= t_val < t2:
        return a1 * (t_val - t1)
    elif t2 <= t_val < t3:
        return a1 * (t2 - t1)  
    elif t3 <= t_val < t4:
        return max(0, a1 * (t2 - t1) * (1 - (t_val - t3) / (t4 - t3)))
    else:
        return 0.0

def f2(t_val):
    if t_val < 0:
        return max(0, b0 + (C - b0)/17 * (-1))
    elif t_val <= 17:
        return b0 + (C - b0)/17 * t_val
    elif t_val < 35:
        return C
    else:
        return C + d1 * (t_val - 35)

def f3(t_val):
    residue = (t_val - t0) % 9
    if residue < 0:
        residue += 9
    return g if residue <= 4 else 0.0

