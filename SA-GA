# 定义模型函数
def main_road_prediction(params, t0):
    """计算主路4的预测流量"""
    t1, t2, t3, t4, a1, a2, b0, C, d1, g = params
    
    # 支路1函数 
    def f1(t_val):
        if t_val < t1:
            return 0.0
        elif t1 <= t_val < t2:
            return a1 * (t_val - t1)
        elif t2 <= t_val < t3:
            return a1 * (t2 - t1)  
        elif t3 <= t_val < t4:
            return max(0, a1 * (t2 - t1) * (1 - (t_val - t3) / (t4 - t3)))
        else:
            return 0.0
    
    # 支路2函数
    def f2(t_val):
        if t_val < 0: 
            return max(0, b0 + (C - b0) / 17 * (-1))
        elif t_val <= 17:
            return b0 + (C - b0) / 17 * t_val
        elif t_val < 35:
            return C
        else:
            return C + d1 * (t_val - 35)
    
    # 支路3
    def f3(t_val):
        residue = (t_val - t0) % 9
        if residue < 0:
            residue += 9
        return g if residue <= 4 else 0.0
    
    # 计算主路的预测值（考虑延迟）
    y_pred = []
    for t_i in t:
        val = f1(t_i - 1) + f2(t_i - 1) + f3(t_i)
        y_pred.append(val)
    
    return np.array(y_pred)

# 定义MSE
def objective(params, t0, y_true):
    y_pred = main_road_prediction(params, t0)
    return mean_squared_error(y_true, y_pred)

# 定义参数边界
bounds = [
    (0, 20),    # t1
    (20, 40),   # t2
    (40, 48),   # t3
    (48, 59),   # t4
    (0, 5),     # a1
    (0, 3),     # a2 
    (0, 20),    # b0
    (20, 50),   # C
    (-2, 0),    # d1
    (0, 50)     # g
]

# 优化过程（GA-SA）
best_mse = float('inf')
best_params = None
best_t0 = None

# 遍历可能的绿灯起始时间t0 
for t0_candidate in range(0, 9):
    # 遗传算法
    result_de = differential_evolution(
        lambda params: objective(params, t0_candidate, y_observed),
        bounds,
        strategy='best1bin',
        maxiter=100,
        popsize=15,
        tol=0.01,
        mutation=(0.5, 1),
        recombination=0.7,
        seed=42
    )
    
    # 模拟退火
    result_sa = dual_annealing(
        lambda params: objective(params, t0_candidate, y_observed),
        bounds,
        x0=result_de.x,
        maxiter=200,
        initial_temp=5230,
        restart_temp_ratio=2e-5,
        seed=42
    )
    
    # 记录最佳结果
    if result_sa.fun < best_mse:
        best_mse = result_sa.fun
        best_params = result_sa.x
        best_t0 = t0_candidate

print(f"最佳t0: {best_t0}")
